generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              String   @id @default(uuid())
  nome            String
  email           String   @unique
  senha           String
  papel           String  
  
  // Novos atributos alinhados com o documento de requisitos
  telefone        String?
  foto_perfil_url String?
  latitude_atual  Float?
  longitude_atual Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  cuidadores           Vinculo_Cuidado[] @relation("Paciente")
  pacientes            Vinculo_Cuidado[] @relation("Cuidador")
  medicamentos         Medicamento[]     @relation("MedicamentosPaciente")
  receitasComoPaciente Receita_Medica[]  @relation("ReceitasPaciente")
  receitasComoMedico   Receita_Medica[]  @relation("ReceitasEmitidas")
}

model Vinculo_Cuidado {
  id           String   @id @default(uuid())
  pacienteId   String
  cuidadorId   String
  status       String   @default("PENDENTE") // Pode ser: PENDENTE, ACEITO, RECUSADO
  
  // Novo atributo alinhado com o documento de requisitos
  nivel_acesso String?  @default("TOTAL") // Ex: TOTAL, LEITURA

  paciente     Usuario  @relation("Paciente", fields: [pacienteId], references: [id])
  cuidador     Usuario  @relation("Cuidador", fields: [cuidadorId], references: [id])

  createdAt    DateTime @default(now())

  //Evita que o mesmo cuidador crie dois vínculos com o mesmo paciente
  @@unique([pacienteId, cuidadorId]) 
}

model Medicamento {
  id           String   @id @default(uuid())
  pacienteId   String
  paciente     Usuario  @relation("MedicamentosPaciente", fields: [pacienteId], references: [id])

  nome         String
  dosagem      String?
  foto_url     String?
  horario      String   // ex: "08:00"
  frequencia   String   @default("DIARIA") // "DIARIA" ou "SEMANAL"
  dias_semana  String?  // ex: "SEGUNDA" ou "SEGUNDA,QUARTA" (só se frequencia = SEMANAL)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registros    Registro_Dose[]
}

model Registro_Dose {
  id                 String       @id @default(uuid())
  medicamentoId      String
  medicamento        Medicamento  @relation(fields: [medicamentoId], references: [id])

  data               DateTime     // data do dia em questão (sem hora, ex: 2026-04-13T00:00:00)
  horario_confirmado DateTime?

  status             String       @default("PENDENTE") // PENDENTE, TOMADO, ATRASADO

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([medicamentoId, data])
}

model Receita_Medica {
  id           String   @id @default(uuid())

  pacienteId   String
  paciente     Usuario  @relation("ReceitasPaciente", fields: [pacienteId], references: [id])

  medicoId     String
  medico       Usuario  @relation("ReceitasEmitidas", fields: [medicoId], references: [id])

  arquivo_url  String
  observacoes  String?
  dataEmissao  DateTime @default(now())

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}